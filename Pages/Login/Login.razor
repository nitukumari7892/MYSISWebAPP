@page "/login"

@using MudBlazor
@inject NavigationManager Nav
@inject AuthService AuthService
@inject IJSRuntime JS

<MudGrid Style="height:100vh">

    <MudItem xs="12" md="7" Style="padding:0">
        <div style="height:100%;
            background:url('/images/2_employee.png') center/cover no-repeat;">
        </div>
    </MudItem>

    <MudItem xs="12" md="5" Class="d-flex align-center justify-center">

        <MudPaper Elevation="4" Style="width:360px; padding:24px; border-radius:12px;">

            <div class="text-center mb-6">
                <img src="/images/2_employee.png" style="height:60px" />
                <MudText Typo="Typo.caption">
                    A Market Leader in Security
                </MudText>
            </div>

            <MudTextField @bind-Value="username"
                          Label="Registration Number"
                          Variant="Variant.Outlined"
                          FullWidth="true"
                          Class="mb-4" />

            <MudTextField @bind-Value="password"
                          Label="Password"
                          Variant="Variant.Outlined"
                          InputType="@(showPassword? InputType.Text: InputType.Password)"
                          Adornment="Adornment.End"
                          AdornmentIcon="@(showPassword? Icons.Material.Filled.VisibilityOff : Icons.Material.Filled.Visibility)"
                          OnAdornmentClick="TogglePassword"
                          FullWidth="true"
                          Class="mb-4"
                          OnKeyDown="HandleKeyDown" />

            @if (!string.IsNullOrEmpty(errorMessage))
            {
                <MudText Color="Color.Error">@errorMessage</MudText>
            }

            <MudButton Variant="Variant.Filled"
                       Color="Color.Error"
                       FullWidth="true"
                       Disabled="@loading"
                       OnClick="HandleLogin">

                @if (loading)
                {
                    <MudProgressCircular Size="Size.Small" Indeterminate="true" />
                }
                else
                {
                    <span>LOGIN</span>
                }

            </MudButton>

        </MudPaper>

    </MudItem>

</MudGrid>

@code {
    string username;
    string password;
    bool showPassword;
    bool loading;
    string errorMessage;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            var token = await JS.InvokeAsync<string>("localStorage.getItem", "token");

            if (!string.IsNullOrEmpty(token))
            {
                Nav.NavigateTo("/dashboard", true);
            }
        }
    }

    void TogglePassword() => showPassword = !showPassword;

    void HandleKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Enter")
            _ = HandleLogin();
    }

    async Task HandleLogin()
    {
        try
        {
            loading = true;
            errorMessage = "";

            var user = await AuthService.Login(new Models.Login.LoginRequest
            {
                UserName = username,
                Password = password
            });

            await JS.InvokeVoidAsync("localStorage.setItem", "token", user.AUTH_TOKEN);

            Nav.NavigateTo("/dashboard", true);
        }
        catch (Exception ex)
        {
            errorMessage = ex.Message;
        }
        finally
        {
            loading = false;
        }
    }
}